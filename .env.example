# ==============================================================================
# WorkivLab — Frontend Client Environment Configuration
# ==============================================================================

# Backend API Endpoint
# In production behind Nginx/Cloudflare reverse proxy: /api/v1
# If hosted on separate subdomain: https://api.workivlab.com/api/v1
API_URL=/api/v1

# Real-time WebSocket Gateway Endpoint
# In production behind reverse proxy: (empty or window.location.origin)
# If hosted on separate subdomain: https://api.workivlab.com
SOCKET_URL=https://api.workivlab.com
